# Example config for the core and full production images.
# Mount as /etc/kiln/kiln.toml
# The full image uses its bundled ffmpeg. The core image leaves the
# compatibility engine unavailable and uses the native packager by default.

[server]
listen = "0.0.0.0:8080"
public_base_url = "http://127.0.0.1:8080"
data_dir = "/var/lib/kiln/data"
# Detects fractional CPU quotas plus nested/parent cgroup memory limits. Memory
# selects compact/balanced/standard below 1 GiB; CPU ceilings apply independently.
resource_mode = "auto"
read_timeout_sec = 15
idle_timeout_sec = 120

[logging]
level = "info"       # debug | info | warn | error
format = "text"      # text (console) | json
color = "never"      # docker logs: no ANSI

[auth]
# Ed25519: mount keys or let first start create {data_dir}/auth/ed25519.pem
# token_private_key_file = "/etc/kiln/ed25519.pem"
# Or: KILN_TOKEN_PRIVATE_KEY / KILN_TOKEN_PRIVATE_KEY_FILE
token_ttl_hours = 24
login_rate_per_min = 20
token_issuer = "kiln"
token_audience = "kiln"

[[auth.users]]
username = "admin"
# generate: go run scripts/hash-password.go 'your-password'
password_hash = "$2a$10$8JxhvnpdTX/TrOTi1XaYWuPlrZK1aw3ANgGIWpTO6KtD2M432w7Ie"
role = "admin"

[security]
play_require_auth = true
allowed_hosts = []
max_playlist_bytes = 8388608
max_body_bytes = 1048576

[ffmpeg]
mode = "native"
binary = "ffmpeg"
hls_time = 2
hls_list_size = 4
log_level = "error"
prefer_height = 1080
low_latency = true

[packager]
# Omit engine to use the image default: native for core, auto for full.
keys_file = "/etc/kiln/kiln.keys"
playlist_size = 8
ll_hls = true
part_target_ms = 500
start_segments = 3
prefetch_segments = 3
max_segment_bytes = 33554432
grace_sec = 30
inflight_bytes = 100663296

[observe]
enabled = true

[debug.pprof]
# Access from inside the container namespace only unless explicitly tunneled.
enabled = false
listen = "127.0.0.1:6060"

[epg]
enabled = false
cache = true
cache_dir = "/var/lib/kiln/data/epg"
refresh_interval_min = 360
# 0 is unlimited normally and becomes a CPU/memory-derived ceiling in auto.
max_refresh_concurrency = 0
max_source_bytes = 67108864
default_timezone = "UTC"
serve_timezone = "keep"

[[upstreams]]
id = "origin"
base_url = "http://origin.example.com:8000"

[[channels]]
id = "channel-news"
title = "News Channel"
group = "News"
epg_id = "channel-news"
epg_name = "News Channel"
upstream = "origin"
path = "/live/news"
ingress = "dash"
on_demand = true
idle_timeout_sec = 120
restart_on_failure = true
preferred_audio_languages = ["yue", "zh", "en"]

[[channels]]
id = "channel-uhd"
title = "UHD Channel"
group = "Entertainment"
epg_id = "channel-uhd"
epg_name = "UHD Channel"
upstream = "origin"
path = "/live/uhd"
ingress = "dash"
on_demand = true
idle_timeout_sec = 120
restart_on_failure = true
preferred_audio_languages = ["yue", "zh", "en"]
