{
  // Kiln example configuration (JSONC)
  // Default admin password: admin
  "server": {
    "listen": "0.0.0.0:8080",
    "public_base_url": "http://127.0.0.1:8080",
    "data_dir": "./data",
    // Keeps the fast path at nominal 4 GB / 4 CPUs and scales below either axis.
    "resource_mode": "auto",
    "read_timeout_sec": 15,
    "idle_timeout_sec": 120,
  },
  "logging": {
    "level": "info",
    "format": "text",
    "color": "auto",
  },
  "auth": {
    "token_ttl_hours": 24,
    "login_rate_per_min": 20,
    "token_issuer": "kiln",
    "token_audience": "kiln",
    "users": [
      {
        "username": "admin",
        "password_hash": "$2a$10$8JxhvnpdTX/TrOTi1XaYWuPlrZK1aw3ANgGIWpTO6KtD2M432w7Ie",
        "role": "admin",
      },
    ],
  },
  "security": {
    "play_require_auth": true,
    "allowed_hosts": [],
    "max_playlist_bytes": 8388608,
    "max_body_bytes": 1048576,
  },
  "ffmpeg": {
    "mode": "native",
    "binary": "ffmpeg",
    "docker_image": "kiln:local",
    "hls_time": 2,
    "hls_list_size": 8,
    "log_level": "error",
  },
  "packager": {
    "engine": "auto",
    "playlist_size": 8,
    "ll_hls": true,
    "part_target_ms": 500,
    "start_segments": 3,
    "prefetch_segments": 3,
    "max_segment_bytes": 33554432,
    "grace_sec": 30,
    "inflight_bytes": 100663296,
  },
  "observe": {
    "enabled": true,
    // "otlp_endpoint": "http://127.0.0.1:4318",
    // "otlp_insecure": true,
    // "trace_sample_ratio": 0.1,
  },
  "epg": {
    "enabled": false,
    "cache": true,
    "refresh_interval_min": 360,
    "max_refresh_concurrency": 0,
    "max_source_bytes": 67108864,
    "default_timezone": "Asia/Hong_Kong",
    "serve_timezone": "keep",
    "sources": [],
  },
  "upstreams": [
    {
      "id": "origin",
      "base_url": "http://127.0.0.1:5050",
    },
  ],
  "channels": [
    {
      "id": "hls-demo",
      "title": "Demo HLS",
      "group": "Origin",
      "upstream": "origin",
      "path": "/live/demo-hls",
      "ingress": "hls",
      "on_demand": true,
      "idle_timeout_sec": 90,
    },
    {
      "id": "dash-demo",
      "title": "Demo DASH",
      "group": "Origin",
      "upstream": "origin",
      "path": "/live/demo-dash",
      "ingress": "dash",
      "on_demand": true,
      "idle_timeout_sec": 90,
      "keys_file": "keys.example.txt",
      "restart_on_failure": true,
      "preferred_audio_languages": ["yue", "zh", "en"],
    },
  ],
}
