---
import { Icon } from "astro-icon/components";
import { Button } from "./ui/button";
import { LinkButton } from "./ui/link-button";
import { ThemeToggle } from "./ui/theme-toggle";
import { SearchTrigger } from "./ui/search";
import { config } from "virtual:nimbus/config";

interface Props {
  /** Astro collection id for the current page, forwarded from DocsLayout. */
  collection?: string;
  /** Astro entry id for the current page, forwarded from DocsLayout. */
  entryId?: string;
  /**
   * Whether the page has a sidebar to open. When `false`, the mobile
   * menu button is hidden — pages that opted out via `sidebar: false`
   * shouldn't show a button that opens an empty dialog. Default `true`.
   */
  showSidebar?: boolean;
}

// `entryId` and `collection` are part of Props as forward-compat hooks (the
// version-switcher recipe reads them) but the base Header doesn't use them —
// leave them off the destructure to avoid unused-var warnings.
const { showSidebar = true } = Astro.props;

// Normalize trailing slash so isActive matches sidebar hrefs.
const currentSlug = Astro.url.pathname.replace(/\/$/, "") || "/";

const isEnglish = currentSlug === "/en" || currentSlug.startsWith("/en/");
const strippedSlug = currentSlug.slice(3);
const langHref = isEnglish
  ? (strippedSlug ? `${strippedSlug}/` : "/")
  : currentSlug === "/"
    ? "/en/"
    : `/en${currentSlug}/`;
const langLabel = isEnglish ? "中文" : "EN";
const langAria = isEnglish ? "切换到中文" : "Switch to English";

const zhSections = [
  { label: "入门", href: "/start/" },
  { label: "指南", href: "/guide/" },
  { label: "参考", href: "/reference/" },
];
const enSections = [
  { label: "Getting started", href: "/en/start/" },
  { label: "Guides", href: "/en/guide/" },
  { label: "Reference", href: "/en/reference/" },
];
const sections = (isEnglish ? enSections : zhSections).map((s) => ({
  ...s,
  isActive: `${currentSlug}/`.startsWith(s.href),
}));
const showSections = true;
---

<header class="sticky top-0 z-30 border-b border-border bg-card/80 backdrop-blur-lg">
  <div class="mx-auto flex items-center justify-between h-14 px-4 lg:px-6">
    <div class="flex items-center gap-3">
      <a href="/" class="group">
        <span class="font-semibold text-sm text-foreground group-hover:text-primary transition-colors">
          {config.title}
        </span>
      </a>

      {showSections && (
        <nav aria-label={isEnglish ? "Sections" : "分区"} class="hidden md:flex items-center gap-1 ml-4 pl-4 border-l border-border h-6">
          {sections.map((section) => (
            <a
              href={section.href}
              aria-current={section.isActive ? "page" : undefined}
              class:list={[
                "px-2 py-1 rounded-md text-[0.8125rem] font-medium no-underline transition-colors",
                section.isActive
                  ? "text-link bg-primary/10"
                  : "text-muted-foreground hover:text-foreground hover:bg-accent/60",
              ]}
            >
              {section.label}
            </a>
          ))}
        </nav>
      )}
    </div>

    <div class="flex items-center gap-2">
      {config.search !== false && <SearchTrigger />}
      {config.github && (
        <LinkButton
          href={config.github}
          variant="minimal"
          shape="square"
          size="sm"
          aria-label="GitHub"
          target="_blank"
          rel="noopener"
          class="text-muted-foreground"
        >
          <Icon name="ph:github-logo" class="w-4 h-4" />
        </LinkButton>
      )}
      <LinkButton
        href={langHref}
        variant="minimal"
        size="sm"
        aria-label={langAria}
        class="text-muted-foreground text-xs font-medium"
      >
        {langLabel}
      </LinkButton>
      <ThemeToggle />
      {showSidebar && (
        <Button
          variant="ghost"
          shape="square"
          size="sm"
          icon="ph:list"
          aria-label={isEnglish ? "Open navigation" : "打开导航"}
          data-menu-btn
          class="lg:hidden text-muted-foreground"
        />
      )}
    </div>
  </div>
</header>
