---
import LandingPage from "../components/LandingPage.astro";
---

<LandingPage
  title="Kiln"
  description="自托管 HLS 与 DASH 频道网关：原生解密重封装、按需拉流、统一鉴权入口。"
  badges={["v1.0.0", "MIT License", "单个二进制"]}
  headingPre="自托管的 "
  headingEmber="HLS / DASH 频道网关"
  sub="原生引擎在进程内解密并重封装 DASH 源，不依赖 ffmpeg；频道按需拉流、空闲自动回收；播放、管理与脚本访问各走各的凭据。Linux、macOS、Windows 全平台，单个二进制即可部署。"
  install="curl -fsSL https://raw.githubusercontent.com/babywbx/kiln/main/install.sh | sh -s -- --lang zh"
  installLabel="一行命令安装"
  ctaPrimary={{ label: "快速开始", href: "/start/" }}
  ctaSecondary={{ label: "浏览文档", href: "/guide/" }}
  featuresTitle="为什么是 Kiln"
  features={[
    {
      icon: "ph:fire",
      title: "原生媒体引擎",
      body: "DASH 解密与重封装在进程内完成，不依赖 ffmpeg；需要兼容回退时也可以交给它。",
    },
    {
      icon: "ph:play-circle",
      title: "按需拉流",
      body: "有人观看才连接上游，空闲自动回收；重要频道可以常驻预热。",
    },
    {
      icon: "ph:key",
      title: "统一鉴权入口",
      body: "登录会话、管理员 API Token、路径式播放密钥与公开端点各管一段，互不越权。",
    },
    {
      icon: "ph:lightning",
      title: "低延迟 HLS",
      body: "原生支持 CMAF part、delta playlist 与 blocking reload。",
    },
    {
      icon: "ph:squares-four",
      title: "管理控制台",
      body: "频道、节目单、出站代理与访问控制在网页里完成，改完即生效。",
    },
    {
      icon: "ph:cpu",
      title: "资源自适应",
      body: "按容器内存与 CPU 配额自动选档，128 MiB 内存的容器也能稳定运行。",
    },
  ]}
  stepsTitle="三步跑起来"
  steps={[
    {
      title: "安装",
      body: "一行命令装好二进制，或直接拉取 Docker 镜像。",
      href: "/start/",
    },
    {
      title: "配置频道",
      body: "在 kiln.toml 或管理控制台里定义上游与频道。",
      href: "/start/first-channel/",
    },
    {
      title: "开始播放",
      body: "播放器打开播放地址，按需拉流自动开始。",
      href: "/guide/playback/",
    },
  ]}
  footerDocs={{ label: "文档", href: "/start/" }}
  footerLang={{ label: "English", href: "/en/" }}
/>
