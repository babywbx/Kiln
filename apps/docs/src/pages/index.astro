---
import LandingPage from "../components/LandingPage.astro";
---

<LandingPage
  title="Kiln"
  description="自托管 HLS 与 DASH 频道网关，原生解密并重封装，按需拉流，统一鉴权。"
  headingPre="自托管的 "
  headingEmber="HLS / DASH 频道网关"
  sub="原生引擎直接在进程内解密并重封装 DASH 源，无需 FFmpeg。频道有人观看时才连接上游，空闲后自动回收。播放、管理和脚本访问各用独立凭据。一个二进制即可部署到 Linux、macOS 或 Windows。"
  install="curl -fsSL https://raw.githubusercontent.com/babywbx/Kiln/main/install.sh | sh -s -- --lang zh"
  installLabel="一行命令安装"
  ctaPrimary={{ label: "快速开始", href: "/start/" }}
  ctaSecondary={{ label: "浏览文档", href: "/guide/" }}
  featuresTitle="为什么是 Kiln"
  features={[
    {
      icon: "ph:fire",
      title: "原生媒体引擎",
      body: "直接在进程内解密并重封装 DASH 源，无需 FFmpeg；遇到不兼容的源时，也可自动回退。",
    },
    {
      icon: "ph:play-circle",
      title: "按需拉流",
      body: "有人观看才连接上游，空闲自动回收；重要频道可以常驻预热。",
    },
    {
      icon: "ph:key",
      title: "统一鉴权入口",
      body: "登录会话、管理员 API Token、路径式播放密钥和公开端点各司其职，权限互不混用。",
    },
    {
      icon: "ph:lightning",
      title: "低延迟 HLS",
      body: "原生支持 CMAF Part、增量播放列表和阻塞式重载。",
    },
    {
      icon: "ph:squares-four",
      title: "管理控制台",
      body: "频道、节目单、出站代理与访问控制在网页里完成，改完即生效。",
    },
    {
      icon: "ph:cpu",
      title: "资源自适应",
      body: "按容器内存与 CPU 配额自动选档，128 MiB 内存的容器也能稳定运行。",
    },
  ]}
  stepsTitle="三步跑起来"
  steps={[
    {
      title: "安装",
      body: "一行命令装好二进制，或直接拉取 Docker 镜像。",
      href: "/start/",
    },
    {
      title: "配置频道",
      body: "在 kiln.toml 或管理控制台里定义上游与频道。",
      href: "/start/first-channel/",
    },
    {
      title: "开始播放",
      body: "播放器打开播放地址，按需拉流自动开始。",
      href: "/guide/playback/",
    },
  ]}
  footerDocs={{ label: "文档", href: "/start/" }}
  footerLang={{ label: "English", href: "/en/" }}
/>
